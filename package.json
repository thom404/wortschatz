{
  "name": "wortschatz",
  "private": true,
  "version": "0.1.3",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b packages/shared packages/engine packages/server && tsc -p packages/client && tsc -p e2e",
    "build": "tsc -b packages/shared packages/engine packages/server && npm run build-dawg && cd packages/client && npx vite build",
    "generate-icons": "node packages/client/scripts/generate-icons.mjs",
    "icons": "node packages/client/scripts/generate-icons.mjs",
    "build-dawg": "node --experimental-strip-types packages/engine/scripts/build-dawg.ts",
    "audit-words": "node --experimental-strip-types packages/server/scripts/audit-word-list.ts",
    "start": "node packages/server/dist/main.js",
    "pretest": "tsc -b packages/shared packages/engine",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
