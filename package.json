{
  "name": "wortschatz",
  "private": true,
  "version": "0.0.0",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -b packages/shared packages/server && tsc -p packages/client",
    "build": "tsc -b packages/shared packages/server && cd packages/client && npx vite build",
    "build-dawg": "node --experimental-strip-types packages/server/scripts/build-dawg.ts",
    "audit-words": "node --experimental-strip-types packages/server/scripts/audit-word-list.ts",
    "start": "node packages/server/dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
